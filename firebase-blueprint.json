{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile including customer and B2B reseller account details and wallet balance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "Google email" },
        "name": { "type": "string", "maxLength": 100, "description": "User display name" },
        "avatar": { "type": "string", "description": "User avatar URL" },
        "shopName": { "type": "string", "maxLength": 100, "description": "Reseller custom shop name" },
        "phone": { "type": "string", "maxLength": 20, "description": "Contact phone number" },
        "role": { "type": "string", "enum": ["customer", "reseller"], "description": "Active user mode" },
        "walletBalance": { "type": "number", "description": "Reseller wallet balance in BDT" },
        "tier": { "type": "string", "enum": ["Silver Dealer", "Gold Merchant", "Platinum Distributor"], "description": "Reseller merchant tier" },
        "apiKey": { "type": "string", "description": "Reseller SMM API key" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" }
      },
      "required": ["id", "email", "name", "role", "walletBalance"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer and reseller placed orders across all 4 categories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order reference code" },
        "userId": { "type": "string", "description": "Owner UID" },
        "type": { "type": "string", "enum": ["physical", "digital", "smm", "recharge"], "description": "Category type" },
        "itemsSummary": { "type": "string", "maxLength": 500, "description": "Summary of items purchased" },
        "totalAmount": { "type": "number", "description": "Amount paid in BDT" },
        "profitEarned": { "type": "number", "description": "Reseller profit if applicable" },
        "isResellerOrder": { "type": "boolean", "description": "Whether placed under B2B mode" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed"], "description": "Execution status" },
        "paymentMethod": { "type": "string", "enum": ["wallet", "bkash", "nagad", "cod"], "description": "Payment channel used" },
        "customerName": { "type": "string", "maxLength": 100, "description": "End recipient name" },
        "customerPhone": { "type": "string", "maxLength": 20, "description": "End recipient phone" },
        "customerAddress": { "type": "string", "maxLength": 300, "description": "Delivery address" },
        "digitalVoucher": { "type": "string", "description": "Activation key or voucher code" },
        "trackingCode": { "type": "string", "description": "Courier or API tracking code" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "userId", "type", "itemsSummary", "totalAmount", "status", "paymentMethod"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Reseller wallet top-up and debit transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Transaction identifier" },
        "userId": { "type": "string", "description": "Owner UID" },
        "type": { "type": "string", "enum": ["deposit", "purchase", "commission_bonus", "refund"], "description": "Transaction type" },
        "amount": { "type": "number", "description": "Signed transaction amount" },
        "description": { "type": "string", "maxLength": 200, "description": "Transaction narrative" },
        "status": { "type": "string", "enum": ["successful", "pending"], "description": "Status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "userId", "type", "amount", "description", "status"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Validation document for connectivity",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Primary user profile document"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders associated with the user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "WalletTransaction",
      "description": "Wallet transactions ledger"
    },
    "/test/{testId}": {
      "schema": "TestConnection",
      "description": "Test collection for verifying Firestore connectivity"
    }
  }
}
